# ── LLM (OpenAI-compatible) ────────────────────────────────────────────────
# Local Ollama:  LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama
# Cloud OpenAI:  LLM_BASE_URL=https://api.openai.com/v1  LLM_API_KEY=sk-...
# Cloud OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_API_KEY=sk-or-...
# MiniMax:        LLM_BASE_URL=https://api.minimax.io/v1  LLM_API_KEY=sk-...
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
# Leave empty to auto-select when the endpoint exposes exactly one model.
LLM_MODEL=
# MiniMax-M3 thinking control: disabled | adaptive | (empty = default).
# "disabled" skips chain-of-thought (faster, cleaner). Only M3 supports this.
LLM_THINKING=

# ── TTS backend ────────────────────────────────────────────────────────────
# chatterbox -> Chatterbox-Turbo via mlx-audio (natural, expressive, real-time,
#               local on Apple Silicon) [default]
# kokoro -> Kokoro-82M via kokoro-onnx (fast, lighter, offline)
# edge   -> Microsoft Edge TTS (free, needs internet)
# piper  -> local piper TTS (offline)
TTS_BACKEND=chatterbox
# Chatterbox-Turbo model (MLX build; downloads on first use).
CHATTERBOX_MODEL=mlx-community/chatterbox-turbo-4bit
# Kokoro-82M model files (download via scripts/download_models.py).
KOKORO_MODEL=models/kokoro-v1.0.onnx
KOKORO_VOICES=models/voices-v1.0.bin
# Kokoro voice name (see Kokoro-82M/VOICES.md, e.g. af_heart, am_onyx).
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0
KOKORO_LANG=en-us
# Voice used by edge-tts (e.g. en-US-AriaNeural). Ignored for chatterbox.
TTS_VOICE=en-US-AriaNeural

# ── Semantic VAD ───────────────────────────────────────────────────────────
# Turn detector mode:
#   semantic -> audio-only turn-end (Silero + Smart Turn v3) [default]
#   llm      -> LLM orchestrator polls partial transcripts + VAD cues and can
#               commit the bot's reply early; audio silence still backstops.
TURN_DETECTOR=semantic
# Turn-end probability threshold for the semantic accelerator (mirrors unmute's 0.6).
VAD_THRESHOLD=0.6
# Seconds of user silence before the "..." long-silence marker is inserted.
USER_SILENCE_TIMEOUT=7.0
# Seconds at the start of the bot's turn during which VAD cannot interrupt
# (lets echo cancellation settle; mirrors unmute's UNINTERRUPTIBLE_BY_VAD_TIME_SEC).
UNINTERRUPTIBLE_BY_VAD_TIME_SEC=3.0
# Hard turn-end: this much silence after speech ends the turn (reliable).
TURN_END_SILENCE_SEC=0.7
# Semantic accelerator: Smart Turn can end the turn after this much silence
# when it is confident (prob > VAD_THRESHOLD).
SEMANTIC_MIN_SILENCE_SEC=0.4
# Barge-in robustness: while the bot speaks, only treat the mic as the user if
# its AEC-cleaned RMS is at least this (ignores the low-level echo residual so
# the bot doesn't interrupt itself). Louder user speech still barges in.
BARGE_IN_MIN_RMS=0.03
# Consecutive energy-gated speech frames required to trigger barge-in.
BARGE_IN_REQUIRED_FRAMES=15

# ── LLM turn orchestrator (only used when TURN_DETECTOR=llm) ───────────────
# How often to re-transcribe the rolling turn buffer for partial transcripts.
TURN_PARTIAL_POLL_INTERVAL_SEC=0.5
# How often to poll the LLM orchestrator while the user is speaking.
TURN_ORCHESTRATOR_POLL_INTERVAL_SEC=0.6
# Don't poll the LLM until the partial transcript is at least this long.
TURN_MIN_PARTIAL_CHARS=12
# Trailing audio window (s) re-transcribed for each partial update.
TURN_STT_POLL_WINDOW_SEC=8.0

# ── Bot active-listening backchannels (VAP) ────────────────────────────────
# When the user is speaking, VAP predicts when to backchannel; the bot then
# emits a short ack ("Mm-hmm") without taking the turn. Off by default (needs
# the VAP model + vendored rvap). Set to true to enable.
BACKCHANNEL_ENABLED=false
VAP_BC_MODEL=models/vap-bc_state_dict_erica_10hz_3000msec.pt
CPC_MODEL=models/60k_epoch4-d0f474de.pt
BACKCHANNEL_THRESHOLD=0.5
BACKCHANNEL_COOLDOWN_SEC=3.0
BACKCHANNEL_ACK_TEXT=Mm-hmm.

# ── Models / paths ────────────────────────────────────────────────────────
# Directory where model weights are stored (see scripts/download_models.py).
MODELS_DIR=models
# faster-whisper model size: tiny | base | small | medium
STT_MODEL=base
# Language hint for STT (e.g. en, fr). Empty = auto-detect.
STT_LANGUAGE=

# ── Acoustic Echo Cancellation (WebRTC AEC3) ───────────────────────────────
# WebRTC AEC3 (the algorithm Chrome uses) removes the bot's own TTS echo from
# the mic so full-duplex barge-in works even without headphones (~52 dB). On by
# default. AEC_DELAY_MS is the speaker->mic delay hint (helps AEC converge).
AEC_ENABLED=true
AEC_DELAY_MS=30
AEC_NOISE_SUPPRESSION=true
AEC_NS_LEVEL=1

# ── Audio ──────────────────────────────────────────────────────────────────
# Input/output device indices (see `unmute-tui --list-devices`). Empty = default.
INPUT_DEVICE=
OUTPUT_DEVICE=
