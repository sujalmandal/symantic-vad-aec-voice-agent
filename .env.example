# ── LLM (OpenAI-compatible) ────────────────────────────────────────────────
# Local Ollama:  LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama
# Cloud OpenAI:  LLM_BASE_URL=https://api.openai.com/v1  LLM_API_KEY=sk-...
# Cloud OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_API_KEY=sk-or-...
# MiniMax:        LLM_BASE_URL=https://api.minimax.io/v1  LLM_API_KEY=sk-...
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
# Leave empty to auto-select when the endpoint exposes exactly one model.
LLM_MODEL=
# MiniMax-M3 thinking control: disabled | adaptive | (empty = default).
# "disabled" skips chain-of-thought (faster, cleaner). Only M3 supports this.
LLM_THINKING=

# ── TTS backend ────────────────────────────────────────────────────────────
# marvis -> Marvis TTS (real-time streaming, MLX-native on Apple Silicon)
# edge   -> Microsoft Edge TTS (free, needs internet)
# piper  -> local piper TTS (offline)
TTS_BACKEND=marvis
# Voice used by edge-tts (e.g. en-US-AriaNeural). Ignored for marvis.
TTS_VOICE=en-US-AriaNeural
# Marvis TTS model id / local path.
MARVIS_MODEL=Marvis-AI/marvis-tts-250m-v0.2
# Optional reference voice for Marvis voice cloning. Leave empty to use the
# default voice downloaded by scripts/download_models.py, or point to your own
# short .wav to clone a custom voice.
TTS_REF_AUDIO=
# Optional transcript of the reference audio (improves cloning).
TTS_REF_TEXT=

# ── Semantic VAD ───────────────────────────────────────────────────────────
# Turn-end probability threshold (mirrors unmute's 0.6). Higher = bot waits longer.
VAD_THRESHOLD=0.6
# Seconds of user silence before the "..." long-silence marker is inserted.
USER_SILENCE_TIMEOUT=7.0
# Seconds at the start of the bot's turn during which VAD cannot interrupt
# (lets echo cancellation settle; mirrors unmute's UNINTERRUPTIBLE_BY_VAD_TIME_SEC).
UNINTERRUPTIBLE_BY_VAD_TIME_SEC=3.0

# ── Models / paths ────────────────────────────────────────────────────────
# Directory where model weights are stored (see scripts/download_models.py).
MODELS_DIR=models
# faster-whisper model size: tiny | base | small | medium
STT_MODEL=base
# Language hint for STT (e.g. en, fr). Empty = auto-detect.
STT_LANGUAGE=

# ── Acoustic Echo Cancellation (WebRTC AEC3) ───────────────────────────────
# WebRTC AEC3 (the algorithm Chrome uses) removes the bot's own TTS echo from
# the mic so full-duplex barge-in works even without headphones (~52 dB). On by
# default. AEC_DELAY_MS is the speaker->mic delay hint (helps AEC converge).
AEC_ENABLED=true
AEC_DELAY_MS=30
AEC_NOISE_SUPPRESSION=true
AEC_NS_LEVEL=1

# ── Audio ──────────────────────────────────────────────────────────────────
# Input/output device indices (see `unmute-tui --list-devices`). Empty = default.
INPUT_DEVICE=
OUTPUT_DEVICE=
